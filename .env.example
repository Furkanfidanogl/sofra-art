# Firebase web app configuration is public by design; this is not an Admin key.
# Optional for real Google sign-in. All other prototype interactions work offline.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=sofra-512816.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sofra-512816
VITE_FIREBASE_APP_ID=1:449977598604:web:17dcbd3c9665e0413eb1a9
# Do NOT put Gemini keys, service account JSON, or other secrets in VITE_* values.

# Enable only after callable Functions, rules and App Check have been deployed/tested.
VITE_SOFRA_BACKEND_ENABLED=false
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Set to true only after Apple Services ID / Key and Firebase apple.com provider are configured.
VITE_APPLE_SIGNIN_ENABLED=false
